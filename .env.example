# Copy to .env for local development. Never use production credentials here.
DATABASE_URL=postgresql://cartattest:cartattest@localhost:5432/cartattest

# PayPal sandbox credentials only. The Gate 0 runner refuses live mode.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_ENV=sandbox
PAYPAL_RETURN_URL=https://example.test/checkout/return
PAYPAL_CANCEL_URL=https://example.test/checkout/cancel
PAYPAL_MERCHANT_ID=
PAYPAL_MERCHANT_EMAIL=

# Semantic attestor configuration (provider/model selected before evaluation).
ATTESTOR_PROVIDER=
ATTESTOR_MODEL_ID=
ATTESTOR_API_KEY=

# Replace with a locally generated private key before using signing features.
CARTATTEST_SERVICE_SIGNING_KEY=
CARTATTEST_SERVICE_KEY_ID=demo-p256-v1
CARTATTEST_BUYER_KEY_ID=
CARTATTEST_BUYER_PUBLIC_KEY_PATH=.codex/keys/buyer.public.pem

# The local sandbox runner uses PayPal Sandbox. Semantic claims remain UNPROVEN until configured.
