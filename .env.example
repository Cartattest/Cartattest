# Copy to .env for local development. Never use production credentials here.
DATABASE_URL=postgresql://cartattest:cartattest@localhost:5432/cartattest
DEMO_MODE=sandbox
PORT=3000

# Required by Sandbox server startup. These local return targets work only in a same-machine browser;
# use the reachable HTTPS URL when exposing the app through a public tunnel.
PAYPAL_RETURN_URL=http://127.0.0.1:3000/checkout/return
PAYPAL_CANCEL_URL=http://127.0.0.1:3000/checkout/cancel

# PayPal sandbox credentials only. The Gate 0 runner refuses live mode.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
# Configure one seller/payee identity for Sandbox mode. If both are present, merchant ID wins.
PAYPAL_MERCHANT_ID=
PAYPAL_MERCHANT_EMAIL=
# Needed only when receiving real webhooks from the matching PayPal app.
PAYPAL_WEBHOOK_ID=

# Generate both local key pairs under ignored .codex/; never commit the private keys.
# pnpm keygen buyer-local-v1 .codex/keys/buyer
# pnpm keygen service-local-v1 .codex/keys/service
CARTATTEST_SERVICE_KEY_ID=service-local-v1
CARTATTEST_SERVICE_PRIVATE_KEY_PATH=.codex/keys/service.private.pem
CARTATTEST_SERVICE_PUBLIC_KEY_PATH=.codex/keys/service.public.pem
CARTATTEST_BUYER_KEY_ID=buyer-local-v1
CARTATTEST_BUYER_PUBLIC_KEY_PATH=.codex/keys/buyer.public.pem
# Used by pnpm replay:e2e to load the matching local buyer private key.
CARTATTEST_BUYER_PRIVATE_KEY_PATH=.codex/keys/buyer.private.pem
# Optional override for pnpm replay:e2e; only local HTTP endpoints are accepted.
CARTATTEST_BASE_URL=http://127.0.0.1:3000

# The server supports PayPal Sandbox or deterministic Replay. Semantic claims fail closed as UNPROVEN;
# ATTESTOR_* settings are not supported because no provider adapter is implemented.
